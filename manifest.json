{
  "manifest_version": 2,
  "name": "React Annotator for Claude",
  "description": "Annotate React components with comments and export for Claude Code",
  "version": "1.0.1",

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],

  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    }
  },

  "background": {
    "scripts": ["background.js"]
  },

  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "react-annotator@syncedsport.com",
      "strict_min_version": "109.0"
    }
  }
}
